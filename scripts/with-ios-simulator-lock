#!/usr/bin/env bash

set -euo pipefail

# CoreSimulator devices are global to the logged-in macOS user. Serialize iOS
# test runs across worktrees and agents to prevent concurrent access to the
# shared simulator.
lock_file="${TMPDIR:-/tmp}/kamaal-auth-ios-simulator-tests.lock"

# CoreSimulator processes need write access outside the repository. When an
# xcodebuild starts inside a filesystem sandbox, the simulator can launch
# far enough for system apps such as PosterBoard to crash before xcodebuild
# reports the underlying permission failure. Probe that access first so the
# simulator is never started in a broken environment.
simulator_directories=(
    "$HOME/Library/Logs/CoreSimulator"
    "$HOME/Library/Developer/CoreSimulator/Devices"
)

for directory in "${simulator_directories[@]}"
do
    probe_file="$(mktemp "$directory/kamaal-auth-simulator-access.XXXXXX" 2>/dev/null || true)"

    if [[ -z "$probe_file" ]]
    then
        cat >&2 <<'EOF'
CoreSimulator is not writable from the current environment.
Re-run the enclosing just recipe outside the filesystem sandbox.
EOF
        exit 1
    fi

    rm -f "$probe_file"
done

# Hold the lock in this shell so signals can be forwarded directly to
# xcodebuild. Running xcodebuild as lockf's child leaves it alive when lockf is
# interrupted, which makes a failed `just ready` impossible to cancel.
exec 9>"$lock_file"
/usr/bin/lockf -k -t 1800 9

xcodebuild "$@" 9>&- &
xcodebuild_pid=$!

terminate_xcodebuild() {
    exit_status="$1"
    trap - INT TERM

    if kill -0 "$xcodebuild_pid" 2>/dev/null
    then
        kill -TERM "$xcodebuild_pid" 2>/dev/null || true

        # Do not let an unresponsive xcodebuild make cancellation hang again.
        (
            exec 9>&-
            sleep 5
            kill -KILL "$xcodebuild_pid" 2>/dev/null || true
        ) &
        watchdog_pid=$!

        wait "$xcodebuild_pid" 2>/dev/null || true
        kill "$watchdog_pid" 2>/dev/null || true
        wait "$watchdog_pid" 2>/dev/null || true
    fi

    exit "$exit_status"
}

trap 'terminate_xcodebuild 130' INT
trap 'terminate_xcodebuild 143' TERM

if wait "$xcodebuild_pid"
then
    xcodebuild_status=0
else
    xcodebuild_status=$?
fi

trap - INT TERM
exit "$xcodebuild_status"
