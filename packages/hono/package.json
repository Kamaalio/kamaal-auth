    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@kamaalio/hono-standard-openapi": ">=0.0.22",
    "hono": "^4.13.13"
