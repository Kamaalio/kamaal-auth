{
  "name": "@kamaalio/kamaal-auth-hono",
  "version": "0.0.0",
  "description": "Mountable Hono auth router. A thin adapter over @kamaalio/kamaal-auth-core, which holds the logic.",
  "license": "MIT",
  "author": "Kamaal Farah",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kamaalio/kamaal-auth",
    "directory": "packages/hono"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kamaalio/kamaal-auth-core": "workspace:*"
  },
  "devDependencies": {
    "@kamaalio/hono-standard-openapi": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@kamaalio/hono-standard-openapi": ">=0.0.22",
    "hono": "^4.13.13"
  },
  "engines": {
    "node": ">=24"
  }
}
